# Superwire Environment Variables Example
# Copy this file to .env.local and fill in your actual values

# ===== REQUIRED VARIABLES =====

# OpenRouter API Configuration (Required for AI content generation)
# Powers all AI text generation including articles, op-eds, and scripts
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-YOUR_OPENROUTER_API_KEY_HERE

# OpenAI API Key (Required for Text-to-Speech)
# Powers the podcast audio generation with OpenAI TTS (12x cheaper than ElevenLabs)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE

# Vercel Blob Storage Token (Required for episode storage)
# Stores generated podcast episodes in Vercel's CDN-backed storage
# Get your token from: Vercel Dashboard > Storage > Create Blob Store
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_YOUR_BLOB_TOKEN_HERE

# News API Key (Required for news ingestion)
# Fetches news articles from multiple sources for content generation
# Get your API key from: https://newsapi.org/register
NEWS_API_KEY=YOUR_NEWS_API_KEY_HERE

# Site URL (Required for API referrer headers)
# Development: http://localhost:3000
# Production: https://your-domain.com
SITE_URL=http://localhost:3000

# Convex Configuration (Required for database operations)
# Stores episodes, articles, and content metadata
# Get these from: https://dashboard.convex.dev/ after running 'npx convex dev'
CONVEX_DEPLOYMENT=prod:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# ===== OPTIONAL VARIABLES =====

# ElevenLabs API Key (Optional - fallback for Text-to-Speech)
# Only needed if OpenAI TTS is unavailable or for specific voice requirements
# Get your API key from: https://elevenlabs.io/
# ELEVEN_LABS_API_KEY=YOUR_ELEVEN_LABS_API_KEY_HERE

# Firebase/Google Service Account (Deprecated - migrated to Vercel Blob)
# Only needed if you have existing episodes in Firebase Storage
# Download service account JSON from Firebase Console, then base64 encode it
# GOOGLE_SERVICE_KEY=YOUR_BASE64_ENCODED_SERVICE_KEY_HERE