# Superwire Environment Variables Example
# Copy this file to .env.local and fill in your actual values

# OpenRouter API Configuration
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-YOUR_OPENROUTER_API_KEY_HERE

# News API Key (for fetching news sources)
# Get your API key from: https://newsapi.org/register
NEWS_API_KEY=YOUR_NEWS_API_KEY_HERE

# ElevenLabs API Key (for text-to-speech)
# Get your API key from: https://elevenlabs.io/
ELEVEN_LABS_API_KEY=YOUR_ELEVEN_LABS_API_KEY_HERE

# Firebase/Google Service Account (base64 encoded JSON)
# Download service account JSON from Firebase Console, then base64 encode it
GOOGLE_SERVICE_KEY=YOUR_BASE64_ENCODED_SERVICE_KEY_HERE

# Site URL (for OpenRouter referrer header)
SITE_URL=http://localhost:3000

# Convex Configuration (will be added after Convex setup)
# Get these from: https://dashboard.convex.dev/
# CONVEX_DEPLOYMENT=
# NEXT_PUBLIC_CONVEX_URL=